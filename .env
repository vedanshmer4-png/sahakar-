# -------------------------------------------------------------
# Sahakar DPI - Environment Variables Configuration
# -------------------------------------------------------------

# Supabase Project Configuration (for Google OAuth & Database)
# Find these in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google OAuth 2.0 Client ID (Optional for direct Google GIS)
# Find this in Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Platform Application Metadata
VITE_APP_NAME=Sahakar
VITE_APP_ENV=production
VITE_APP_URL=https://sahakar-coop.surge.sh
VITE_NATIONAL_HELPLINE=+919557687953
VITE_SUPPORT_EMAIL=vedanshmer4@gmail.com
